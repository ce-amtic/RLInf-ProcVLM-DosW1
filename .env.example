# Public ProcVLM source checkout. The launchers already default to this path.
PROCVLM_REPO_PATH=/absolute/path/to/RLInf-ProcVLM-DosW1/third_party/ProcVLM

# Python executable from a ProcVLM-compatible environment. Required.
PROCVLM_PYTHON=/absolute/path/to/procvlm-environment/bin/python

# Merged ProcVLM reward checkpoint. Kept outside Git.
PROCVLM_REWARD_MODEL_PATH=/absolute/path/to/merged/procvlm-checkpoint

# DOS-W1 flow-policy model used by both actor and rollout.
DOSW1_POLICY_MODEL_PATH=/absolute/path/to/dosw1-flow-policy

# Demonstration replay buffer used by the official DOS-W1 RLPD recipe.
DOSW1_DEMO_BUFFER_PATH=/absolute/path/to/dosw1-demo-buffer

# Python executable from the RLInf environment. Defaults to .venv/bin/python.
RLINF_PYTHON=/absolute/path/to/rlinf-environment/bin/python

# DOS-W1 task prompt used by the environment and ProcVLM input builder.
DOSW1_TASK_DESCRIPTION="Pick up the object with the left arm."

# Stage-2-only reward image size. Actor images remain 128x128.
DOSW1_PROCVLM_REWARD_IMAGE_SIZE=336
