# Public ProcVLM source checkout. The launchers already default to this path.
PROCVLM_REPO_PATH=/absolute/path/to/RLInf-ProcVLM-DosW1/third_party/ProcVLM

# Python executable from a ProcVLM-compatible environment. Required.
PROCVLM_PYTHON=/absolute/path/to/procvlm-environment/bin/python

# Merged ProcVLM reward checkpoint. Kept outside Git.
PROCVLM_REWARD_MODEL_PATH=/absolute/path/to/merged/procvlm-checkpoint
