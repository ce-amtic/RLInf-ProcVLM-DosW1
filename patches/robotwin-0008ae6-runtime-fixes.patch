+def _get_env_flag(name, default=False):
+    value = os.getenv(name)
+    if value is None:
+        return default
+    return value.strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _get_env_float(name, default=None):
+    value = os.getenv(name)
+    if value is None or value.strip() == "":
+        return default
+    try:
+        return float(value)
+    except ValueError:
+        logging.warning("Invalid %s=%r; using %r.", name, value, default)
+        return default
+
+
+def _get_env_int(name, default):
+    value = os.getenv(name)
+    if value is None or value.strip() == "":
+        return default
+    try:
+        return int(value)
+    except ValueError:
+        logging.warning("Invalid %s=%r; using %r.", name, value, default)
+        return default
+
+
+def _get_vector_env_max_workers(n_envs):
+    value = os.getenv("ROBOTWIN_VECTOR_ENV_MAX_WORKERS")
+    if value is None or value.strip() == "":
+        return n_envs
+    try:
+        max_workers = int(value)
+    except ValueError:
+        logging.warning(
+            "Invalid ROBOTWIN_VECTOR_ENV_MAX_WORKERS=%r; using %s workers.",
+            value,
+            n_envs,
+        )
+        return n_envs
+    if max_workers <= 0:
+        return n_envs
+    return max(1, min(n_envs, max_workers))
+
+
+def _load_action_delta_limit(action_dim):
+    fallback_delta = _get_env_float("ROBOTWIN_ACTION_GUARD_MAX_DELTA", 0.75)
+    delta_limit = np.full(action_dim, fallback_delta, dtype=np.float32)
+    stats_path = os.getenv("ROBOTWIN_ACTION_STATS_PATH")
+    if not stats_path:
+        return delta_limit
+    try:
+        with open(stats_path, "r", encoding="utf-8") as f:
+            stats = json.load(f)
+        stats = stats.get("norm_stats", stats)
+        action_stats = stats.get("actions", stats.get("action"))
+        if action_stats is None:
+            raise KeyError("actions")
+        q01 = np.asarray(action_stats["q01"], dtype=np.float32)
+        q99 = np.asarray(action_stats["q99"], dtype=np.float32)
+        stats_limit = np.maximum(np.abs(q01), np.abs(q99))[:action_dim]
+        delta_limit[: stats_limit.shape[0]] = stats_limit
+    except Exception as exc:
+        logging.warning(
+            "Failed to load RoboTwin action guard stats from %s: %s; using max_delta=%s.",
+            stats_path,
+            exc,
+            fallback_delta,
+        )
+
+    scale = _get_env_float("ROBOTWIN_ACTION_GUARD_DELTA_SCALE", 1.0)
+    return np.maximum(delta_limit * scale, 1e-3).astype(np.float32)
+
+
+def _array_range(values):
+    finite = np.asarray(values)[np.isfinite(values)]
+    if finite.size == 0:
+        return "all-nonfinite"
+    return f"{float(finite.min()):.4g}..{float(finite.max()):.4g}"
+
 
